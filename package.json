{
  "name": "library-web",
  "version": "1.0.0",
  "description": "Library Management System Website - OOP project (TypeScript + Node.js + SQLite)",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
